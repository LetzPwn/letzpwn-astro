---
import Layout from './Layout.astro'
import { COLLECTION_LABELS, formatDate, isoDate, type Post } from '../lib/posts'

interface Props {
  post: Post
}

const { post } = Astro.props

const byline = [post.author, formatDate(post.date)].filter(Boolean).join(' · ')
---

<Layout
  title={post.title}
  subtitle={COLLECTION_LABELS[post.collection]}
  description={post.excerpt ??
    `${COLLECTION_LABELS[post.collection]} from LetzPwn: ${post.title}.`}
  extra={byline}
  tags={post.tags}
  image={post.cover.src}
  article={{ publishedTime: isoDate(post.date), author: post.author }}
>
  <article class="section">
    <div class="auto-container">
      <div class="prose">
        <slot />
      </div>
    </div>
  </article>
</Layout>
