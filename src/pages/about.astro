---
import Layout from '../layouts/Layout.astro'
import TeamMember from '../components/TeamMember.astro'

const goals = [
  {
    icon: 'flaticon-growth',
    title: "Spread awareness about CTF's and recruit new members",
    text: `The CTF community is still very small in Luxembourg. It is important to
      continuously spread awareness and recruit new members to stand a chance in
      global competitions and represent Luxembourg in the best possible way. We
      will try our best to find ways to contact and integrate new members: on
      social media, asking friends, at events, ...`
  },
  {
    icon: 'flaticon-question',
    title: 'Help and train members in cybersecurity & CTF challenges',
    text: `On the Discord server, members will find resources and guides from other
      members on how to get started. They'll be able to ask questions to the
      other members if they're stuck or need some guidance on how to proceed.
      The aim is to participate in online CTFs as much as possible (currently
      about 2 to 3 per month on weekends) so that newcomers can apply the
      knowledge they've acquired in a safe and judgement-free environment, with
      the bonus of moving the team forward if they manage to solve something.
      During online CTFs the team collaborates in the Discord server.`
  },
  {
    icon: 'flaticon-plan',
    title: 'Participate in CTFs',
    text: `One of the main purposes of the community is to participate in CTFs. Our
      end goal is to strengthen the team's practical hacking skills and to be
      able to represent Luxembourg as a real competitor in relevant CTF events.`
  },
  {
    icon: 'flaticon-calendar',
    title: 'Meetups and workshops',
    text: `In addition to online CTF events, we'd like to organise meetups
      throughout the year to compete in CTFs while working together in a
      physical space. Furthermore, depending on the resources we have at our
      disposal, we'd love to organise workshops with experts to further develop
      our knowledge.`
  },
  {
    icon: 'flaticon-award',
    title: 'European Cyber Security Challenge (ECSC)',
    text: `The ECSC is a CTF where European countries compete against each other.
      Every participating country puts together a team of at most 10 members (5
      juniors, 5 seniors). If you are between 15 and 25 years old and are a
      Luxembourgish resident, this might be of interest to you. The first step
      to participate in the ECSC is to contact us as soon as possible, and we
      will happily provide you with further details. The ECSC usually takes
      place in autumn, however the qualification often starts 6-9 months prior.
      The results of the Luxembourg Cyber Security Challenge determine the team
      selection for the ECSC. Thereafter, workshops and tutoring sessions with
      experts are organised to prepare the team for the ECSC. If you missed the
      qualification, there might still be a chance to participate, so feel free
      to contact us :)`
  }
]

const board = [
  {
    name: 'Mike',
    pseudo: 'punshLineLama',
    role: 'President',
    blurb: "Doesn't know how to build a website"
  },
  {
    name: 'Fred',
    pseudo: 'F_rZy',
    role: 'Treasurer',
    blurb: 'Numbers guy, maybe good with a calculator'
  },
  {
    name: 'Olivier',
    pseudo: 'ganymede',
    role: 'Secretary',
    blurb: 'Not an author but still does the writing'
  },
  {
    name: 'Mika',
    pseudo: 'SourceDiver42',
    role: 'Infrastructure Manager',
    blurb: "Built a website but still doesn't know how it works"
  },
  {
    name: 'Frank',
    pseudo: 'Luxy',
    role: 'Founder',
    blurb: "Is enthusiastic about CTF's and cybersecurity"
  },
  {
    name: 'Jaak',
    pseudo: 'voyyce',
    role: 'Founder',
    blurb: 'Is not a fan of websites, hence he exploits them'
  },
  {
    name: 'Peer',
    pseudo: 'AshF0x',
    role: 'Founder',
    blurb: 'CTFs are life'
  }
]
---

<Layout
  title="About LetzPwn"
  subtitle="About Us"
  description="Who we are, what we want to achieve, and who runs LetzPwn asbl."
>
  <section class="section">
    <div class="auto-container">
      <div class="sec-title centered">
        <h2>Our goals</h2>
      </div>
      <ul class="goal-grid">
        {
          goals.map((goal) => (
            <li class="goal">
              <span class={`goal__icon ${goal.icon}`} aria-hidden="true" />
              <h3 class="goal__title">{goal.title}</h3>
              <p class="goal__text">{goal.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="auto-container">
      <div class="sec-title centered">
        <h2>Board &amp; Founders</h2>
      </div>
      <ul class="card-grid">
        {
          board.map((member) => (
            <TeamMember
              name={member.name}
              pseudo={member.pseudo}
              role={member.role}
            >
              {member.blurb}
            </TeamMember>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="auto-container stack-center">
      <div class="sec-title centered">
        <h2>Statuts / Bylaws</h2>
      </div>
      <a
        class="theme-btn btn-style-one"
        href="https://gd.lu/rcsl/5N9Vh3"
        rel="noopener external"
        target="_blank"
      >
        <span class="fas fa-file-pdf" aria-hidden="true"></span>
        <span class="btn-title">Download our bylaws</span>
      </a>
    </div>
  </section>
</Layout>

<style>
  .goal-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: var(--lp-gap);
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .goal {
    padding: 28px;
    background: var(--lp-surface);
    border: 1px solid var(--lp-border);
    border-radius: var(--lp-radius);
  }

  .goal__icon {
    display: block;
    margin-bottom: 12px;
    color: var(--lp-accent-text);
    font-size: 40px;
  }

  .goal__title {
    margin: 0 0 12px;
    font-size: 1.25rem;
    line-height: 1.3;
  }

  .goal__text {
    margin: 0;
    color: var(--lp-muted);
    line-height: 1.7;
  }

  .theme-btn.btn-style-one {
    display: inline-flex;
    gap: 12px;
    align-items: center;
  }
</style>
