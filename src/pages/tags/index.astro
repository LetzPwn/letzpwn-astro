---
import Layout from '../../layouts/Layout.astro'
import { getTagsWithPosts } from '../../lib/posts'

const tags = await getTagsWithPosts()
---

<Layout
  title="Tags"
  subtitle="Browse by Tag"
  description="Browse LetzPwn news and CTF writeups by topic."
>
  <section class="section">
    <div class="auto-container">
      {
        tags.length > 0 ? (
          <ul class="tag-list tag-index">
            {tags.map((tag) => (
              <li>
                <a class="tag" href={tag.url}>
                  {tag.name} <span class="count">({tag.posts.length})</span>
                </a>
              </li>
            ))}
          </ul>
        ) : (
          <p>No tags yet.</p>
        )
      }
    </div>
  </section>
</Layout>

<style>
  .tag-index {
    gap: 12px;
    font-size: 1rem;
  }

  .count {
    color: var(--lp-muted);
  }
</style>
