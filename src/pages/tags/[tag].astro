---
import Layout from '../../layouts/Layout.astro'
import PostCard from '../../components/PostCard.astro'
import { getTagsWithPosts, type TagWithPosts } from '../../lib/posts'

export async function getStaticPaths() {
  const tags = await getTagsWithPosts()
  return tags.map((tag) => ({ params: { tag: tag.slug }, props: { tag } }))
}

interface Props {
  tag: TagWithPosts
}

const { tag } = Astro.props
---

<Layout
  title={`Tag: ${tag.name}`}
  pageTitle={`Posts tagged "${tag.name}" | LetzPwn`}
  subtitle="Tags"
  description={`LetzPwn news and writeups tagged "${tag.name}".`}
>
  <section class="section">
    <div class="auto-container">
      <ul class="card-grid">
        {
          tag.posts.map((post, index) => (
            <PostCard post={post} eager={index < 3} />
          ))
        }
      </ul>
      <p class="back"><a href="/tags">← All tags</a></p>
    </div>
  </section>
</Layout>

<style>
  .back {
    margin-top: 2.5rem;
  }

  .back a {
    color: var(--lp-accent-text);
  }
</style>
