---
import Layout from '../layouts/Layout.astro'
import { CONTACT_EMAIL } from '../lib/site'

const channels = [
  {
    icon: 'fas fa-envelope',
    label: CONTACT_EMAIL,
    href: `mailto:${CONTACT_EMAIL}`,
    external: false
  },
  {
    icon: 'fab fa-discord',
    label: 'Join our Discord server',
    href: 'https://discord.letzpwn.lu',
    external: true
  },
  {
    icon: 'fab fa-instagram',
    label: '@letzpwnasbl',
    href: 'https://www.instagram.com/letzpwnasbl/',
    external: true
  },
  {
    icon: 'fab fa-twitter',
    label: '@LetzPwnAsbl',
    href: 'https://twitter.com/LetzPwnAsbl',
    external: true
  }
]
---

<Layout
  title="Contact Us"
  subtitle="Get in Touch"
  description="Reach LetzPwn by email, Discord, Instagram or Twitter."
>
  <section class="section">
    <div class="auto-container">
      <p class="intro">
        If you have any questions or want to connect, feel free to reach out
        through any of the following:
      </p>

      <ul class="channels">
        {
          channels.map((channel) => (
            <li class="channel">
              <span
                class={`channel__icon ${channel.icon}`}
                aria-hidden="true"
              />
              <a
                class="channel__link"
                href={channel.href}
                rel={channel.external ? 'noopener external' : undefined}
                target={channel.external ? '_blank' : undefined}
              >
                {channel.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Layout>

<style>
  .intro {
    max-width: 60ch;
    margin: 0 auto 2.5rem;
    font-size: 1.2rem;
    text-align: center;
  }

  .channels {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: var(--lp-gap);
    max-width: 1000px;
    padding: 0;
    margin: 0 auto;
    list-style: none;
  }

  .channel {
    display: flex;
    flex-direction: column;
    gap: 12px;
    align-items: center;
    padding: 1.75rem;
    text-align: center;
    background: var(--lp-surface);
    border: 1px solid var(--lp-border);
    border-radius: var(--lp-radius);
  }

  .channel__icon {
    color: var(--lp-accent-text);
    font-size: 2.5rem;
  }

  .channel__link {
    color: var(--lp-accent-text);
    font-size: 1.15rem;
    text-decoration: none;
    word-break: break-word;
  }

  .channel__link:hover,
  .channel__link:focus {
    text-decoration: underline;
  }
</style>
