---
import Layout from '../layouts/Layout.astro'
import PostCard from '../components/PostCard.astro'
import { getPosts } from '../lib/posts'

const [news, writeups] = await Promise.all([
  getPosts('news'),
  getPosts('writeups')
])

const latestNews = news.slice(0, 3)
const latestWriteups = writeups.slice(0, 3)
---

<Layout
  title="LUXEMBOURGISH CTF/CYBERSECURITY COMMUNITY"
  pageTitle="LetzPwn - Luxembourgish CTF Team"
  subtitle="Welcome to LetzPwn"
  description="LetzPwn is the first Luxembourgish CTF team: a community that helps people of any age and skill level get into cybersecurity."
>
  <section class="section">
    <div class="auto-container">
      <div class="intro">
        <p>
          LetzPwn is a community that helps people, no matter their skill or
          age, to learn more about cybersecurity. We aim to do this by providing
          first steps into the cybersecurity world for any interested person. To
          further enhance all of the team's skills, we are participating in
          Capture the Flag (CTF) competitions. A CTF is usually about solving
          cybersecurity related riddles. For each solved riddle a team gets
          points. The team with the most points wins, easy right? If you want to
          know more details about how CTFs work, feel free to contact us or do
          some internet research. A good entry point for your research might be
          <a href="https://ctftime.org/ctf-wtf/" rel="noopener">this site</a>.
        </p>
        <p>
          Our main platform for the community is Discord, it's free and easy to
          join. Come say hi!
        </p>
      </div>

      <div class="stack-center">
        <div class="button-row">
          <a href="/about" class="theme-btn btn-style-one">
            <span class="btn-title">About us</span>
          </a>
          <a
            href="https://discord.letzpwn.lu"
            class="theme-btn btn-style-one"
            rel="noopener"
          >
            <span class="btn-title">Join Discord</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="auto-container">
      <div class="sec-title centered">
        <h2>Latest News</h2>
      </div>
      {
        latestNews.length > 0 ? (
          <ul class="card-grid">
            {latestNews.map((post, index) => (
              <PostCard post={post} eager={index === 0} />
            ))}
          </ul>
        ) : (
          <p class="empty">No news posts yet.</p>
        )
      }
      <div class="stack-center more">
        <a href="/news" class="theme-btn btn-style-one">
          <span class="btn-title">More news</span>
        </a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="auto-container">
      <div class="sec-title centered">
        <h2>Latest Writeups</h2>
      </div>
      {
        latestWriteups.length > 0 ? (
          <ul class="card-grid">
            {latestWriteups.map((post) => (
              <PostCard post={post} />
            ))}
          </ul>
        ) : (
          <p class="empty">No writeups yet.</p>
        )
      }
      <div class="stack-center more">
        <a href="/writeups" class="theme-btn btn-style-one">
          <span class="btn-title">More writeups</span>
        </a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .intro {
    max-width: 70ch;
    margin: 0 auto 2.5rem;
    font-size: 1.125rem;
    line-height: 1.7;
  }

  .intro a {
    color: var(--lp-accent-text);
  }

  .more {
    margin-top: 2.5rem;
  }

  .empty {
    text-align: center;
    color: var(--lp-muted);
  }
</style>
