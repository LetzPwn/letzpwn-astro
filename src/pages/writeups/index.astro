---
import Layout from '../../layouts/Layout.astro'
import PostCard from '../../components/PostCard.astro'
import Pagination from '../../components/Pagination.astro'
import { getPosts, POSTS_PER_PAGE } from '../../lib/posts'

const allPosts = await getPosts('writeups')
const posts = allPosts.slice(0, POSTS_PER_PAGE)
const lastPage = Math.max(1, Math.ceil(allPosts.length / POSTS_PER_PAGE))
---

<Layout
  title="Writeups"
  subtitle="Writeups"
  description="CTF challenge writeups published by members of LetzPwn."
>
  <section class="section">
    <div class="auto-container">
      {
        posts.length > 0 ? (
          <ul class="card-grid">
            {posts.map((post, index) => (
              <PostCard post={post} eager={index < 3} />
            ))}
          </ul>
        ) : (
          <p>Nothing published yet.</p>
        )
      }
      <Pagination basePath="/writeups" currentPage={1} lastPage={lastPage} />
    </div>
  </section>
</Layout>
