---
import Layout from '../../layouts/Layout.astro'
import PostCard from '../../components/PostCard.astro'
import Pagination from '../../components/Pagination.astro'
import { getPosts, POSTS_PER_PAGE, type Post } from '../../lib/posts'

// Page 1 is served by index.astro, so only pages 2..n are generated here.
// Post slugs are date-prefixed file names, so they never collide with a number.
export async function getStaticPaths() {
  const posts = await getPosts('writeups')
  const lastPage = Math.ceil(posts.length / POSTS_PER_PAGE)

  return Array.from({ length: Math.max(0, lastPage - 1) }, (_, index) => {
    const page = index + 2
    return {
      params: { page: String(page) },
      props: {
        posts: posts.slice((page - 1) * POSTS_PER_PAGE, page * POSTS_PER_PAGE),
        currentPage: page,
        lastPage
      }
    }
  })
}

interface Props {
  posts: Post[]
  currentPage: number
  lastPage: number
}

const { posts, currentPage, lastPage } = Astro.props
---

<Layout
  title="Writeups"
  pageTitle={`Writeups — page ${currentPage} | LetzPwn`}
  subtitle="Writeups"
  description="CTF challenge writeups published by members of LetzPwn."
>
  <section class="section">
    <div class="auto-container">
      <ul class="card-grid">
        {posts.map((post, index) => <PostCard post={post} eager={index < 3} />)}
      </ul>
      <Pagination
        basePath="/writeups"
        currentPage={currentPage}
        lastPage={lastPage}
      />
    </div>
  </section>
</Layout>
