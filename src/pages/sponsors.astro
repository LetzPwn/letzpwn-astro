---
import Layout from '../layouts/Layout.astro'
// When sponsors come back, drop <Sponsor /> entries into the .card-grid below:
// import Sponsor from '../components/Sponsor.astro'
---

<Layout
  title="Our Sponsors"
  subtitle="Sponsors"
  description="LetzPwn is looking for partners to support cybersecurity education, events and our CTF community."
>
  <section class="section">
    <div class="auto-container">
      <div class="no-sponsors">
        <h2>We currently have no active sponsors.</h2>
        <p>
          We're open to new partnerships that support cybersecurity education,
          events, and our CTF community.
        </p>
        <a href="/contact" class="theme-btn btn-style-one">
          <span class="btn-title">Become a sponsor</span>
        </a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .no-sponsors {
    max-width: 40rem;
    padding: 2.5rem;
    margin: 0 auto;
    text-align: center;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid var(--lp-border);
    border-radius: 12px;
  }

  .no-sponsors h2 {
    margin-bottom: 1rem;
    font-size: 1.75rem;
    font-weight: 700;
    letter-spacing: 0.5px;
  }

  .no-sponsors p {
    margin-bottom: 2rem;
    font-size: 1.1rem;
    line-height: 1.6;
    color: var(--lp-muted);
  }

  .no-sponsors .theme-btn {
    display: inline-block;
  }
</style>
