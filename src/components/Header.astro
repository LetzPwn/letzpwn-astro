---
import { Image } from 'astro:assets'
import logo from '../assets/logo.png'
import {
  NAV_ITEMS,
  NAV_SPLIT,
  SITE_NAME,
  SITE_TAGLINE,
  SOCIAL_LINKS,
  isActive
} from '../lib/site'

const currentPath = Astro.url.pathname
const navGroups = [
  { items: NAV_ITEMS.slice(0, NAV_SPLIT), align: 'pull-left' },
  { items: NAV_ITEMS.slice(NAV_SPLIT), align: 'pull-right' }
]
---

<header class="main-header">
  <!-- Header Top -->
  <div class="header-top">
    <div class="auto-container clearfix">
      <div class="top-left clearfix">
        <ul class="info-list">
          <li>{SITE_TAGLINE}</li>
        </ul>
      </div>

      <div class="top-right">
        <ul class="social-icons">
          {
            SOCIAL_LINKS.map((social) => (
              <li>
                <a
                  href={social.url}
                  rel="noopener me"
                  aria-label={`${SITE_NAME} on ${social.name}`}
                >
                  <span class={social.icon} aria-hidden="true" />
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>

  <!-- Header Upper -->
  <div class="header-upper">
    <div class="inner-container">
      <div class="auto-container clearfix">
        <div class="logo-outer">
          <div class="logo">
            <a href="/" aria-label={`${SITE_NAME} home`}>
              <Image
                src={logo}
                alt={`${SITE_NAME} logo`}
                width={260}
                height={260}
                loading="eager"
              />
            </a>
          </div>
        </div>

        <div class="nav-outer clearfix">
          <button
            type="button"
            class="nav-toggle"
            aria-label="Open menu"
            aria-expanded="false"
            aria-controls="site-drawer"
          >
            <span class="icon flaticon-menu-1" aria-hidden="true"></span>
          </button>

          <nav class="main-menu" aria-label="Main">
            <div class="navbar-collapse clearfix">
              {
                navGroups.map((group) => (
                  <ul class={`navigation clearfix ${group.align}`}>
                    {group.items.map((item) => (
                      <li
                        class={
                          isActive(currentPath, item.path) ? 'current' : ''
                        }
                      >
                        <a
                          href={item.path}
                          aria-current={
                            isActive(currentPath, item.path)
                              ? 'page'
                              : undefined
                          }
                        >
                          {item.name}
                        </a>
                      </li>
                    ))}
                  </ul>
                ))
              }
            </div>
          </nav>
        </div>
      </div>
    </div>
  </div>

  <!-- Mobile Menu -->
  <div class="drawer" id="site-drawer" hidden>
    <div class="drawer__backdrop"></div>

    <nav class="drawer__panel" aria-label="Mobile">
      <button type="button" class="drawer__close" aria-label="Close menu">
        <span class="icon flaticon-close" aria-hidden="true"></span>
      </button>

      <div class="drawer__logo">
        <a href="/" aria-label={`${SITE_NAME} home`}>
          <Image src={logo} alt="" width={150} height={150} loading="lazy" />
        </a>
      </div>

      <ul class="drawer__nav">
        {
          NAV_ITEMS.map((item) => (
            <li>
              <a
                href={item.path}
                aria-current={
                  isActive(currentPath, item.path) ? 'page' : undefined
                }
              >
                {item.name}
              </a>
            </li>
          ))
        }
      </ul>

      <ul class="drawer__socials">
        {
          SOCIAL_LINKS.map((social) => (
            <li>
              <a
                href={social.url}
                rel="noopener me"
                aria-label={`${SITE_NAME} on ${social.name}`}
              >
                <span class={social.icon} aria-hidden="true" />
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  /* The vendored template only styles the desktop header, so the logo sizing
     and the whole mobile drawer are defined here. */
  .main-header :global(.logo img) {
    width: auto;
    max-width: 260px;
    height: auto;
  }

  /* The template draws the "current page" indicator as a 3px bar across the
     middle of the label, which reads as a strikethrough. Move it underneath. */
  .main-menu :global(.navigation > li > a::before) {
    top: auto;
    bottom: -4px;
    margin-top: 0;
    background-color: var(--lp-accent);
  }

  .nav-toggle {
    display: none;
    padding: 0;
    color: #fff;
    font-size: 28px;
    background: none;
    border: 0;
    cursor: pointer;
  }

  @media only screen and (max-width: 1023px) {
    .main-header :global(.logo img) {
      max-width: 180px;
      max-height: 80px;
      object-fit: contain;
    }

    .main-header :global(.top-right) {
      display: none;
    }

    /* Decorative shapes from the desktop header overlap the mobile layout. */
    .main-header :global(.header-upper::before),
    .main-header :global(.header-upper .inner-container::before),
    .main-header :global(.nav-outer::before) {
      content: none;
    }

    .nav-toggle {
      display: block;
    }
  }

  /* Own class names (.drawer*) rather than the template's .mobile-menu, whose
     rules force opacity:0 / visibility:hidden and would have to be fought with
     !important on every declaration. */
  .drawer {
    position: fixed;
    inset: 0;
    z-index: 99999;
  }

  .drawer[hidden] {
    display: none;
  }

  .drawer__backdrop {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.7);
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .drawer__panel {
    position: absolute;
    inset: 0 0 0 auto;
    width: min(320px, 100%);
    padding: 80px 24px 24px;
    overflow-y: auto;
    background: #111;
    transform: translateX(100%);
    transition: transform 0.3s ease;
  }

  .drawer.open .drawer__backdrop {
    opacity: 1;
  }

  .drawer.open .drawer__panel {
    transform: translateX(0);
  }

  .drawer__close {
    position: absolute;
    top: 20px;
    right: 20px;
    padding: 0;
    color: #fff;
    font-size: 24px;
    background: none;
    border: 0;
    cursor: pointer;
  }

  .drawer__logo {
    margin-bottom: 30px;
  }

  .drawer__logo :global(img) {
    width: auto;
    max-width: 150px;
    height: auto;
  }

  .drawer__nav {
    padding: 0;
    margin: 0 0 30px;
    list-style: none;
  }

  .drawer__nav li + li {
    margin-top: 18px;
  }

  .drawer__nav a {
    color: #fff;
    font-size: 18px;
    text-decoration: none;
  }

  .drawer__nav a[aria-current='page'] {
    color: var(--lp-accent-text);
  }

  .drawer__socials {
    display: flex;
    gap: 18px;
    padding: 0;
    margin: 0;
    list-style: none;
    font-size: 20px;
  }

  .drawer__socials a {
    color: #fff;
  }
</style>

<script>
  const toggler = document.querySelector<HTMLButtonElement>('.nav-toggle')
  const drawer = document.querySelector<HTMLElement>('.drawer')
  const closeBtn = drawer?.querySelector<HTMLButtonElement>('.drawer__close')
  const backdrop = drawer?.querySelector<HTMLElement>('.drawer__backdrop')

  if (toggler && drawer) {
    const openDrawer = () => {
      drawer.hidden = false
      toggler.setAttribute('aria-expanded', 'true')
      document.body.style.overflow = 'hidden'
      // Let the browser paint the closed state before transitioning in.
      requestAnimationFrame(() => {
        drawer.classList.add('open')
        closeBtn?.focus()
      })
    }

    const closeDrawer = () => {
      drawer.classList.remove('open')
      toggler.setAttribute('aria-expanded', 'false')
      document.body.style.overflow = ''
      toggler.focus()
      window.setTimeout(() => {
        if (!drawer.classList.contains('open')) drawer.hidden = true
      }, 300)
    }

    toggler.addEventListener('click', openDrawer)
    closeBtn?.addEventListener('click', closeDrawer)
    backdrop?.addEventListener('click', closeDrawer)

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && !drawer.hidden) closeDrawer()
    })
  }
</script>
