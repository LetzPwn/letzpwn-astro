---
import { Image } from 'astro:assets'
import logo from '../assets/logo.png'
import {
  CONTACT_EMAIL,
  FOOTER_LINKS,
  SITE_NAME,
  SOCIAL_LINKS
} from '../lib/site'

const year = new Date().getFullYear()
---

<footer class="main-footer">
  <div class="auto-container">
    <div class="widgets-section">
      <div class="row clearfix">
        <!-- Logo Column -->
        <div class="column col-lg-4 col-md-6 col-sm-12">
          <div class="footer-widget logo-widget">
            <div class="logo">
              <a href="/" aria-label={`${SITE_NAME} home`}>
                <Image
                  src={logo}
                  alt={`${SITE_NAME} logo`}
                  width={200}
                  height={200}
                  loading="lazy"
                />
              </a>
            </div>
          </div>
        </div>

        <!-- Links Column -->
        <div class="column col-lg-4 col-md-6 col-sm-12">
          <nav class="footer-widget links-widget" aria-label="Footer">
            <div class="widget-content">
              <div class="footer-title">
                <h2>Links</h2>
              </div>
              <ul class="list footer-links">
                {
                  FOOTER_LINKS.map((link) => (
                    <li>
                      <a href={link.path}>{link.name}</a>
                    </li>
                  ))
                }
              </ul>
            </div>
          </nav>
        </div>

        <!-- Contact Column -->
        <div class="column col-lg-4 col-md-6 col-sm-12">
          <div class="footer-widget links-widget">
            <div class="widget-content">
              <div class="footer-title">
                <h2>Contact</h2>
              </div>
              <ul class="list">
                <li>
                  <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>
                </li>
                <li>
                  <a href="https://discord.letzpwn.lu" rel="noopener">
                    Discord server
                  </a>
                </li>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Footer Bottom -->
  <div class="footer-bottom">
    <div class="auto-container">
      <button
        type="button"
        class="scroll-to-top"
        aria-label="Back to top"
        hidden
      >
        <span class="flaticon-up-arrow" aria-hidden="true"></span>
      </button>

      <div class="row clearfix">
        <div class="column col-lg-6 col-md-12 col-sm-12">
          <div class="copyright">
            &copy; 2022-{year}
            {SITE_NAME} asbl. All rights reserved.
          </div>
        </div>
        <div class="column col-lg-6 col-md-12 col-sm-12">
          <ul class="social-icons">
            {
              SOCIAL_LINKS.map((social) => (
                <li>
                  <a
                    href={social.url}
                    rel="noopener me"
                    aria-label={`${SITE_NAME} on ${social.name}`}
                  >
                    <span class={social.icon} aria-hidden="true" />
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </div>
</footer>

<style>
  /* The template centres the footer widgets vertically, which leaves the
     column headings at different heights. */
  .main-footer :global(.widgets-section .row) {
    align-items: flex-start;
  }

  /* Two balanced link columns without a nested grid; the template's own
     columns did not line up. */
  .footer-links {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0 20px;
  }

  /* The template renders footer links in #848484, which is too dim on the
     near-black footer. */
  .links-widget :global(.list li a) {
    color: var(--lp-muted);
  }

  .links-widget :global(.list li a:hover),
  .links-widget :global(.list li a:focus) {
    color: var(--lp-accent-text);
  }

  .scroll-to-top {
    background: none;
    border: 0;
    cursor: pointer;
  }

  .scroll-to-top[hidden] {
    display: none;
  }
</style>

<script>
  const scrollTop = document.querySelector<HTMLButtonElement>('.scroll-to-top')

  if (scrollTop) {
    const toggleVisibility = () => {
      scrollTop.hidden = window.scrollY < 200
    }

    scrollTop.addEventListener('click', () => {
      window.scrollTo({ top: 0, behavior: 'smooth' })
    })

    window.addEventListener('scroll', toggleVisibility, { passive: true })
    toggleVisibility()
  }
</script>
