{
  "name": "letzpwn-astro",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "check": "astro check && npm run lint && npm run prettier:check",
    "preview": "astro preview",
    "prepare": "husky",
    "astro": "astro",
    "lint": "eslint . --ext .js,.cjs,.ts",
    "prettier:check": "prettier --cache --check .",
    "format": "prettier --cache --write ."
  },
  "dependencies": {
    "@astrojs/mdx": "^7.0.5",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.6.0",
    "astro": ">=7.2.2",
    "sharp": "^0.35.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.3",
    "@types/node": "^22.7.4",
    "@typescript-eslint/eslint-plugin": "^8.8.0",
    "@typescript-eslint/parser": "^8.8.0",
    "eslint": "^8.57.1",
    "husky": "^9.1.6",
    "lint-staged": "^15.2.10",
    "prettier": "^3.3.3",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^5.6.2"
  },
  "lint-staged": {
    "*.{astro,ts,js,cjs,mjs,json,md,mdx,css}": "prettier --write"
  }
}
